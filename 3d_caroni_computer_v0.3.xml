document.addEventListener('DOMContentLoaded', function() {
    const previewModal = document.getElementById('preview-modal');
    const btnOpen = document.getElementById('btn-open-preview');
    const btnClose = document.getElementById('btn-close-preview');

    // --- FUNCIÓN PRINCIPAL: ACTUALIZAR DATOS ---
    function updatePreviewData() {
        
        // 1. TEXTOS (Títulos y Descripciones)
        // Indices en Services: 
        // 0: Clientes/Aliados
        // 1, 2, 3: Tarjetas de Servicio
        // 4: Video
        for (let i = 0; i <= 4; i++) {
            // Títulos
            const inputTitle = document.querySelector(`input[name="service_title_${i}"]`);
            const previewTitle = document.getElementById(`preview-title-${i}`);
            if(inputTitle && previewTitle) previewTitle.innerText = inputTitle.value;

            // Textos
            const inputText = document.querySelector(`textarea[name="service_text_${i}"]`);
            const previewText = document.getElementById(`preview-text-${i}`);
            if(inputText && previewText) {
                previewText.innerHTML = inputText.value.replace(/\n/g, '<br>');
            }
        }

        // 2. IMÁGENES ESTÁTICAS
        // Slot 0: Banner Principal
        updateImagePreview(0, 'preview-banner-bg', true);

        // Slots 1, 2, 3: Imágenes de tarjetas de servicio
        for (let j = 1; j <= 3; j++) {
            updateImagePreview(j, `preview-img-${j}`, false);
        }

        // 3. LOGOS DE CLIENTES (Dinámicos)
        // Buscamos todos los slots dentro del contenedor de clientes
        updateClientsPreview();

        // 4. VIDEO (Youtube)
        updateVideoPreview();
    }

    // --- HELPER: Actualizar Imágenes Simples ---
    function updateImagePreview(slotIndex, targetId, isBackground) {
        const fileInput = document.querySelector(`input[name="image_slot_${slotIndex}"]`);
        const existingImg = document.querySelector(`input[name="slot_image_id_${slotIndex}"]`);
        const targetEl = document.getElementById(targetId);
        
        if (!targetEl) return;

        // Path base depende de si es banner o cuerpo
        const basePath = (slotIndex === 0) ? '/assets/uploads/services/banner/' : '/assets/uploads/services/body/';

        if (fileInput && fileInput.files && fileInput.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                if(isBackground) {
                    targetEl.style.backgroundImage = `url('${e.target.result}')`;
                } else {
                    targetEl.src = e.target.result;
                    targetEl.style.display = 'block';
                }
            }
            reader.readAsDataURL(fileInput.files[0]);
        } else if (existingImg && existingImg.value) {
            const fullPath = basePath + existingImg.value;
            if(isBackground) {
                targetEl.style.backgroundImage = `url('${fullPath}')`;
            } else {
                targetEl.src = fullPath;
                targetEl.style.display = 'block';
            }
        } else {
            if(!isBackground) targetEl.style.display = 'none';
        }
    }

    // --- HELPER: Actualizar Clientes Dinámicos ---
    function updateClientsPreview() {
        const container = document.getElementById('preview-clients-container');
        container.innerHTML = ''; // Limpiar

        // Buscar todos los slots visuales en el admin dentro de #clients-container
        // Nota: Los inputs reales pueden tener índices altos (image_slot_4, image_slot_105, etc.)
        const clientSlots = document.querySelectorAll('#clients-container .image-slot');

        clientSlots.forEach(slot => {
            // Ignorar el botón de agregar (+)
            if(slot.id === 'btn-add-client') return;

            const fileInput = slot.querySelector('input[type="file"]');
            const hiddenInput = slot.querySelector('input.slot-image-id');
            const deleteInput = slot.querySelector('input.delete-slot-flag');

            // Si está marcado para borrar, no mostrar
            if(deleteInput && deleteInput.value === 'DELETE') return;

            let src = null;

            if (fileInput && fileInput.files && fileInput.files[0]) {
                src = URL.createObjectURL(fileInput.files[0]);
            } else if (hiddenInput && hiddenInput.value) {
                src = '/assets/uploads/services/body/' + hiddenInput.value;
            }

            if (src) {
                const img = document.createElement('img');
                img.src = src;
                img.style.height = '60px';
                img.style.width = 'auto';
                img.style.objectFit = 'contain';
                container.appendChild(img);
            }
        });
    }

    // --- HELPER: Actualizar Video ---
    function updateVideoPreview() {
        const inputLink = document.querySelector('textarea[name="service_link"]');
        const container = document.getElementById('preview-video-container');
        const iframe = document.getElementById('preview-video-iframe');

        if (inputLink && inputLink.value.trim() !== '') {
            const url = inputLink.value;
            let videoId = '';

            // Lógica simple para extraer ID de Youtube (igual que en PHP)
            if (url.includes('youtu.be/')) {
                videoId = url.split('youtu.be/')[1];
            } else if (url.includes('v=')) {
                videoId = url.split('v=')[1].split('&')[0];
            }

            if (videoId) {
                iframe.src = `https://www.youtube.com/embed/${videoId}`;
                container.style.display = 'block';
            } else {
                container.style.display = 'none';
            }
        } else {
            container.style.display = 'none';
        }
    }

    // --- EVENTOS ---
    if(btnOpen) {
        btnOpen.addEventListener('click', function() {
            updatePreviewData();
            previewModal.style.display = 'block';
            document.body.style.overflow = 'hidden'; 
        });
    }

    if(btnClose) {
        btnClose.addEventListener('click', function() {
            previewModal.style.display = 'none';
            document.body.style.overflow = 'auto';
        });
    }
});
</file>

<file path="public/assets/admin/js/avatar-cropper.js">
document.addEventListener('DOMContentLoaded', function() {
    const fileInput = document.getElementById('image-input');
    const modal = document.getElementById('crop-modal');
    const imageToCrop = document.getElementById('image-to-crop');
    const btnCrop = document.getElementById('btn-crop-confirm');
    const btnCancel = document.getElementById('btn-cancel-crop');
    
    // Elementos de tu vista actual para mostrar el resultado final
    const previewContainer = document.getElementById('image-preview-container'); // El placeholder (+)
    const uploadBoxLabel = document.querySelector('.image-upload-box label');

    let cropper = null;

    // 1. Interceptar la selección de archivo
    fileInput.addEventListener('click', function() {
        // Resetear valor para permitir seleccionar la misma imagen si se canceló antes
        this.value = null;
    });

    fileInput.addEventListener('change', function(e) {
        if (e.target.files && e.target.files.length > 0) {
            const file = e.target.files[0];
            
            // Validar que sea imagen
            if (!file.type.startsWith('image/')) return;

            const reader = new FileReader();
            reader.onload = function(evt) {
                // Cargar imagen en el modal
                imageToCrop.src = evt.target.result;
                modal.style.display = 'flex';

                // Iniciar Cropper
                if (cropper) cropper.destroy();
                cropper = new Cropper(imageToCrop, {
                    aspectRatio: 1 / 1, // FORZAR CUADRADO EXACTO
                    viewMode: 1,        // Restringir el cuadro dentro de la imagen
                    autoCropArea: 1,
                });
            };
            reader.readAsDataURL(file);
        }
    });

    // 2. Acción de Recortar
    btnCrop.addEventListener('click', function() {
        if (!cropper) return;

        // Obtener el canvas recortado
        const canvas = cropper.getCroppedCanvas({
            width: 500,  // Redimensionar a un tamaño razonable para avatar
            height: 500,
            imageSmoothingQuality: 'high'
        });

        // Convertir canvas a Blob (archivo)
        canvas.toBlob(function(blob) {
            // Crear un nuevo archivo File desde el Blob
            const croppedFile = new File([blob], "avatar_recortado.webp", { type: "image/webp" });

            // TRUCO: Reemplazar el archivo en el input original
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(croppedFile);
            fileInput.files = dataTransfer.files;

            // --- ACTUALIZAR LA VISTA PREVIA (Reutilizando lógica visual) ---
            // Ocultar placeholder
            if(previewContainer) previewContainer.style.display = 'none';
            
            // Limpiar previews anteriores si existen
            const existingFrame = uploadBoxLabel.querySelector('.image-preview-frame');
            if (existingFrame) existingFrame.remove();

            // Crear el marco de preview (tomado de tu CSS actual)
            const frame = document.createElement('div');
            frame.classList.add('image-preview-frame');
            
            const img = document.createElement('img');
            img.classList.add('image-preview');
            img.src = canvas.toDataURL('image/webp'); // Mostrar el resultado recortado

            const removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'remove-preview-btn';
            removeBtn.innerHTML = "<i class='bx bx-x'></i>";
            
            // Lógica para borrar el preview
            removeBtn.onclick = (e) => {
                e.preventDefault(); 
                frame.remove();
                if(previewContainer) previewContainer.style.display = 'flex';
                fileInput.value = ''; // Limpiar input
            };

            frame.appendChild(img);
            frame.appendChild(removeBtn);
            uploadBoxLabel.appendChild(frame);
            
            // Agregar clase al padre para quitar bordes
            uploadBoxLabel.closest('.image-upload-box').classList.add('has-preview');

            // Cerrar modal
            closeModal();

        }, 'image/webp', 0.9);
    });

    // 3. Cancelar
    btnCancel.addEventListener('click', function() {
        fileInput.value = ''; // Limpiar selección
        closeModal();
    });

    function closeModal() {
        modal.style.display = 'none';
        if (cropper) {
            cropper.destroy();
            cropper = null;
        }
    }
});
</file>

<file path="public/assets/admin/js/brands.js">
document.addEventListener('DOMContentLoaded', function() {
    const visibilityButtons = document.querySelectorAll('.btn-visibility-toggle');

    visibilityButtons.forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            
            const brandId = this.getAttribute('data-id');
            const currentHidden = parseInt(this.getAttribute('data-current-hidden'));
            const newStatus = currentHidden === 1 ? 0 : 1; 

            const formData = new FormData();
            formData.append('brand_id', brandId);
            formData.append('hidden_status', newStatus);

            fetch('/admin/brands/toggle-visibility', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Usamos la función global para recargar la página y mostrar el mensaje
                    if (typeof reloadWithScroll === 'function') {
                        reloadWithScroll(data.message);
                    } else {
                        // Respaldo por si falla la carga del otro script
                        sessionStorage.setItem('pendingToast', data.message);
                        location.reload();
                    }
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire('Error', 'Hubo un problema de conexión.', 'error');
            });
        });
    });
});
</file>

