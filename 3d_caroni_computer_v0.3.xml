/* --- Ajustes Específicos para Slots de Slider/Banner --- */
/* Asegura que el contenido interno se ajuste al tamaño definido en el PHP */

.image-preview-slot-frame {
    width: 100%;
    height: 100%;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 4px;
    position: relative;
