}

/* Migas de Pan (Exactamente 1.25rem a los lados) */
.lvr-breadcrumb-detail {
    margin-left: 1.5rem !important;
    margin-right: 1.5rem !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    font-size: 0.85rem;
    color: var(--lvr-muted-foreground);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap; 
}

/* Tarjetas Blancas (Exactamente 1rem a los lados) */
.lvr-card-section {
    margin-left: 1.5rem !important;
    margin-right: 1.5rem !important;
    background: #ffffff;
    border-radius: 1.5rem;
