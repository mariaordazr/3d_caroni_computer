}

.lvr-badge-new { background-color: var(--lvr-success); color: white; padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; }
.lvr-badge-offer { background-color: #ef4444; color: white; padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; }

/* Tipografía Info Compactada */
.lvr-info-header { margin-bottom: 0.35rem; }
.lvr-category-brand { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; color: var(--lvr-muted-foreground); text-transform: uppercase; }

/* Título y precio reducidos */
.product-info__title { font-family: var(--lvr-font-display) !important; font-size: 1.35rem !important; font-weight: 700 !important; color: var(--lvr-foreground) !important; line-height: 1.25 !important; margin-bottom: 0.2rem !important; }
.lvr-sku-text { font-size: 0.8rem; color: var(--lvr-muted-foreground); margin-bottom: 1rem; }

/* Precios y Stock Compactados */
.product-info__price { margin-bottom: 0.75rem !important; }
.offer-price { font-family: var(--lvr-font-display) !important; font-size: 1.125rem !important; font-weight: 700 !important; color: var(--lvr-foreground) !important; letter-spacing: -0.02em !important; }
.offer-price small { font-size: 1.1rem; font-weight: 600; color: var(--lvr-muted-foreground); }
.original-price { font-size: 0.95rem !important; color: #94a3b8 !important; text-decoration: line-through; }

/* Envoltorio para controlar el ancho de la etiqueta de stock */
.lvr-stock-wrapper { display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 1.25rem; }
.lvr-stock-pill { 
    display: inline-flex !important; 
    align-items: center !important; 
    justify-content: flex-start;
    gap: 0.5rem; 
    padding: 0.35rem 0.85rem !important; 
    border-radius: 9999px; 
