                FROM offers o
                INNER JOIN products p ON o.product = p.id_product
                LEFT JOIN categories c ON p.category = c.id_category
                LEFT JOIN brands b ON p.brand = b.id_brand
                LEFT JOIN product_images pi ON p.id_product = pi.product";

