.modal-content {
    position: relative;
    width: 90%;
    height: 80vh; /* Ocupará el 80% del alto de la pantalla */
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden; /* Ocultamos el scroll natural del navegador */
    background-color: transparent; /* Fondo transparente para evitar franjas grises */
    border-radius: 4px;
}

/* =========================================
   AJUSTES MODAL ESTILO MERCADO LIBRE
   ========================================= */

/* 1. Asegurar que el lienzo ocupe exactamente la caja y no se desborde */
.zoom-canvas { 
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: zoom-in; 
}
.zoom-canvas.is-zoomed { cursor: zoom-out; }

/* 2. Imagen base SIEMPRE contenida en la pantalla sin recortarse */
#modal-current-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain; /* Clave: ajusta la imagen sin deformarla ni cortarla */
    transition: transform 0.25s ease-out; 
    will-change: transform, transform-origin;
}

/* 3. Miniaturas estilo ML (Centradas y elegantes en Escritorio) */
.modal-thumbnails {
    margin-top: 15px; 
    display: flex; 
    gap: 12px; 
    overflow-x: auto; 
    max-width: 90%;
    justify-content: center; /* Centra las cajitas */
    z-index: 2005;
}

.modal-thumbnail-item {
    width: 55px; 
    height: 55px; 
    opacity: 0.5; 
    cursor: pointer; 
    border: 2px solid transparent; 
    border-radius: 6px;
    background: #fff;
    transition: all 0.2s ease;
    padding: 2px;
}

.modal-thumbnail-item img {
    width: 100%; 
    height: 100%; 
    object-fit: contain; 
    border-radius: 4px;
}

.modal-thumbnail-item:hover {
    opacity: 0.8;
}

.modal-thumbnail-item.is-active { 
    opacity: 1; 
    border-color: #0d6efd; /* Borde azul de elemento seleccionado */
}

/* .zoom-canvas { cursor: zoom-in; } */

/* .zoom-canvas.is-zoomed { cursor: zoom-out; } */

.zoom-canvas.is-dragging {
    cursor: grabbing !important;
    transition: none; /* Quitamos transición al arrastrar para que sea inmediato */
}

/* Transición fluida para el zoom en escritorio */
/* #modal-current-image {
    transition: transform 0.25s ease-out; 
    will-change: transform, transform-origin;
} */

/* --- Estado de la imagen CON ZOOM --- */
#modal-current-image.is-zoomed {
    max-width: none;
    max-height: none;
    cursor: grab;
}

.modal-content:active #modal-current-image.is-zoomed {
    cursor: grabbing;
}

/* --- Controles de Zoom Mejorados --- */
.zoom-controls-container {
    position: absolute;
    top: 25px; 
    left: 50%; /* Centrado horizontal */
    transform: translateX(-50%); /* Ajuste fino del centrado */
    
    background: rgba(0, 0, 0, 0.7);
    padding: 10px 25px; /* Más padding */
    border-radius: 30px; /* Bordes más redondeados */
    display: flex;
    align-items: center;
    gap: 15px;
    z-index: 2005;
    color: white;
    backdrop-filter: blur(5px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
}

.zoom-controls-container input[type=range] {
    width: 250px; /* Barra mucho más ancha, como en tu imagen de referencia */
    cursor: pointer;
    accent-color: #fff; 
}

.zoom-controls-container i {
    font-size: 1.5rem; 
    cursor: pointer;
    transition: color 0.2s, transform 0.2s;
}

.zoom-controls-container i:hover {
    color: #ccc;
    transform: scale(1.1);
}

/* Opcional: En móviles, achicar la barra */
@media screen and (max-width: 600px) {
    .zoom-controls-container {
        width: 90%;
        justify-content: center;
    }
    .zoom-controls-container input[type=range] {
        width: 100%; 
    }
}



.modal-close-btn {
    position: absolute; top: 20px; right: 30px; color: #fff; font-size: 2.5rem; cursor: pointer; z-index: 2001;
}
.modal-prev-btn, .modal-next-btn {
    cursor: pointer; position: absolute; top: 50%; padding: 1rem; color: white; font-weight: bold; font-size: 1.5rem;
    background-color: rgba(0,0,0,0.3); border-radius: 4px; user-select: none; transform: translateY(-50%); z-index: 2001;
}
.modal-prev-btn { left: 20px; }
.modal-next-btn { right: 20px; }

