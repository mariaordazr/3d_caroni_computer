} elseif ($segments[0] === 'servicios') { // <-- AÑADE ESTA RUTA
    $controller = new PublicController($connection);
    $controller->services();

} elseif ($segments[0] === 'envios') { // <-- AÑADE ESTA RUTA
    $controller = new PublicController($connection);
    $controller->shipping();

} else {
    // Ruta principal (homepage)
    $controller = new PublicController($connection);
    $controller->index();
}

// Cierre de la conexión
if (isset($connection)) {
    $connection->close();
}
