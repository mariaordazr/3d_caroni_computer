}

/* =========================================================
   REDISEÑO LOVABLE: CATEGORÍAS, MARCAS, USUARIOS Y BLOGS
   ========================================================= */

/* Unificación de contenedores de Lista y Cuadrícula en basic_list */
.product-view-container.view-list .lvr-entity-list {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.75rem !important;
    width: 100% !important;
}

.product-view-container.view-grid .lvr-entity-list {
    display: none !important;
}

.product-view-container.view-list .lvr-entity-grid {
    display: none !important;
}

.product-view-container.view-grid .lvr-entity-grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 1.25rem !important;
    width: 100% !important;
    box-sizing: border-box !important;
    margin-top: 0.5rem !important;
}

/* Filas de lista para Categorías, Marcas, Usuarios y Blogs */
.lvr-entity-row {
    display: grid !important;
    grid-template-columns: minmax(0, 1.6fr) auto 36px !important;
    align-items: center !important;
    gap: 1.25rem !important;
    padding: 1rem 1.35rem !important;
    border-radius: 16px !important;
    background-color: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    box-shadow: var(--lvr-shadow-soft) !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease !important;
    position: relative !important;
    width: 100% !important;
    box-sizing: border-box !important;
}

.lvr-entity-row:hover {
    transform: translateY(-2px) !important;
    box-shadow: var(--lvr-shadow-lift) !important;
    border-color: #cbd5e1 !important;
}

.lvr-entity-row.is-hidden,
.lvr-entity-card.is-hidden {
    opacity: 0.68 !important;
    background-color: #f8fafc !important;
    border: 1px dashed #cbd5e1 !important;
}

.lvr-entity-row > a.lvr-product-main-link {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 1rem !important;
    min-width: 0 !important;
    width: 100% !important;
    text-decoration: none !important;
}

.lvr-entity-row .table-item-ml__actions,
.lvr-entity-row .product-item-ml__actions {
    position: static !important;
    top: auto !important;
    right: auto !important;
}

/* Miniaturas circulares/recortadas para Usuarios y Blogs */
.lvr-thumb-cover {
    padding: 0 !important;
    overflow: hidden !important;
}

.lvr-thumb-cover picture,
.lvr-thumb-cover img {
    width: 100% !important;
    height: 100% !important;
    max-height: none !important;
    object-fit: cover !important;
    border-radius: inherit !important;
    display: block !important;
}

/* Tarjetas de cuadrícula para Categorías, Marcas, Usuarios y Blogs */
.lvr-entity-card {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    padding: 1.15rem !important;
    border-radius: 16px !important;
    background: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    box-shadow: var(--lvr-shadow-soft) !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.65rem !important;
    position: relative !important;
}

.lvr-entity-card .grid-item-card__actions {
    position: absolute !important;
    top: 0.75rem !important;
    right: 0.75rem !important;
    z-index: 10 !important;
}

/* Badge de Equipo Entregado en Artículos a Recibir */
.item-delivered-label {
    background: #dcfce7;
    color: #15803d !important;
    border: 1px solid #86efac;
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 0.76rem !important;
    font-weight: 700 !important;
    display: none;
    align-items: center;
    gap: 4px;
}

.item-delivered-label.is-delivered {
    display: inline-flex !important;
}

.lvr-item-card.is-delivered-card {
    border-color: #86efac !important;
    background: #f0fdf4 !important;
}

@media (max-width: 1100px) {
    .product-view-container.view-grid .lvr-entity-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 1rem !important;
    }

    .lvr-entity-row {
        display: flex !important;
        flex-direction: column !important;
        align-items: flex-start !important;
        gap: 0.85rem !important;
        padding: 1.1rem !important;
    }

    .lvr-entity-row > a.lvr-product-main-link {
        width: calc(100% - 36px) !important;
    }

    .lvr-entity-row .product-item-ml__actions,
    .lvr-entity-row .table-item-ml__actions {
        position: absolute !important;
        top: 1rem !important;
        right: 1rem !important;
    }
}

@media (max-width: 640px) {
    .product-view-container.view-grid .lvr-entity-grid {
        grid-template-columns: minmax(0, 1fr) !important;
        gap: 0.9rem !important;
    }
}

/* =========================================================
   REDISEÑO LOVABLE: CREAR Y EDITAR PRODUCTO (DESKTOP, TABLET Y MÓVIL)
   ========================================================= */

/* 1. Filas dinámicas de Características principales */
.lvr-features-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
}

.lvr-feature-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
}

.lvr-feature-num {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #f1f5f9;
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.lvr-feature-remove {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: #94a3b8;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s;
    flex-shrink: 0;
}
.lvr-feature-remove:hover {
    background: #fee2e2;
    color: #dc2626;
}

.lvr-muted-counter {
    font-weight: 400;
    color: #64748b;
    font-size: 0.82rem;
    margin-left: 4px;
}

/* 2. Stepper de Stock (- 0 +) y Precio con prefijo de moneda */
.lvr-stock-stepper {
    display: flex;
    align-items: center;
    height: 42px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #ffffff;
    overflow: hidden;
}

.lvr-stepper-btn {
    width: 42px;
    height: 100%;
    border: none;
    background: #f8fafc;
    color: #334155;
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
    flex-shrink: 0;
}
.lvr-stepper-btn:hover {
    background: #e2e8f0;
}
.lvr-stepper-btn.minus { border-right: 1px solid #e2e8f0; }
.lvr-stepper-btn.plus  { border-left: 1px solid #e2e8f0; }

.lvr-stock-stepper input[type="number"] {
    flex: 1;
    width: 100% !important;
    height: 100% !important;
    border: none !important;
    background: transparent !important;
    text-align: center !important;
    font-size: 0.9rem !important;
    font-weight: 700 !important;
    color: #0f172a !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 0 8px !important;
    -moz-appearance: textfield;
}
.lvr-stock-stepper input[type="number"]::-webkit-outer-spin-button,
.lvr-stock-stepper input[type="number"]::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
}

.lvr-price-input-wrap {
    display: flex;
    align-items: center;
    height: 42px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #ffffff;
    padding: 0 14px;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.lvr-price-input-wrap:focus-within {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

.lvr-currency-prefix {
    color: #64748b;
    font-size: 0.88rem;
    font-weight: 600;
    margin-right: 8px;
    user-select: none;
}

.lvr-price-input-wrap input[type="number"] {
    flex: 1;
    width: 100% !important;
    height: 100% !important;
    border: none !important;
    background: transparent !important;
    text-align: right !important;
    font-size: 0.9rem !important;
    font-weight: 600 !important;
    color: #0f172a !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    -moz-appearance: textfield;
}
.lvr-price-input-wrap input[type="number"]::-webkit-outer-spin-button,
.lvr-price-input-wrap input[type="number"]::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
}

/* 3. Píldoras de selección (Certificación, Condición y Garantía) */
.lvr-pill-selector-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.lvr-pill-option {
    height: 36px;
    padding: 0 16px;
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    color: #0f172a;
    font-family: var(--lvr-font-body);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
}
.lvr-pill-option:hover {
