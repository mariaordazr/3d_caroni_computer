.lvr-breadcrumb-detail a { color: var(--lvr-muted-foreground); text-decoration: none; }
.lvr-breadcrumb-detail a:hover { color: var(--lvr-primary); }
.lvr-breadcrumb-detail i { font-size: 1rem; }

/* Límite de caracteres con puntos suspensivos para el título de la miga */
.lvr-breadcrumb-title {
    color: var(--lvr-foreground); 
    font-weight: 600; 
    display: inline-block;
    max-width: 250px; 
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
}

/* Layout Superior (Info y Galeria) */
.product-detail-layout {
    display: grid !important;
    /* Da más espacio horizontal a la imagen (1.25fr) respecto a la info (0.75fr) */
    grid-template-columns: 1.25fr 0.75fr !important;
    gap: 3.5rem !important;
}

/* Fix Galería */
.gallery-main-image { border: none !important; border-radius: 1rem !important; }
.thumbnail-item { border-radius: 0.75rem !important; border: 2px solid transparent !important; background: #f8fafc !important; }
.thumbnail-item.is-active, .thumbnail-item:hover { border-color: var(--lvr-primary) !important; opacity: 1 !important; }

/* Badges sobre Imagen */
.lvr-gallery-badges { 
