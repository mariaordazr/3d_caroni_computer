    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.product-card__image img,
.product-card__image picture {
    width: 100%;
    height: 100%;
    object-fit: contain; /* Evita que la imagen se deforme o se corte */
    transition: transform 0.3s;
}





