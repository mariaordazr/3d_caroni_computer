/* 3. SUPERPONER EL MENÚ DE 3 PUNTITOS Y DROPDOWNS DE ESTADO POR ENCIMA DE TODO */
.table-item-ml,
.product-item-ml,
.grid-item-card {
    position: relative !important;
    z-index: 1 !important;
    overflow: visible !important;
}

/* Al pasar el ratón sin menú abierto, solo sube ligeramente (nivel 5) */
.table-item-ml:hover,
.product-item-ml:hover,
.grid-item-card:hover {
    z-index: 5 !important;
}

/* Cuando la fila o tarjeta TIENE UN MENÚ ABIERTO, sube al nivel 9999 (nunca la tapará el hover de abajo) */
.table-item-ml:focus-within,
.product-item-ml:focus-within,
.grid-item-card:focus-within,
.table-item-ml.menu-active,
.product-item-ml.menu-active,
.grid-item-card.menu-active,
.table-item-ml:has(.actions-dropdown.is-active),
.table-item-ml:has(.actions-dropdown.active),
.table-item-ml:has(.actions-dropdown.show),
.product-item-ml:has(.actions-dropdown.is-active),
.product-item-ml:has(.actions-dropdown.active),
.product-item-ml:has(.actions-dropdown.show),
.product-item-ml:has(.status-dropdown.is-active),
.product-item-ml:has(.status-dropdown.active),
.product-item-ml:has(.status-dropdown.show),
.product-item-ml:has(.type-dropdown.is-active),
.product-item-ml:has(.type-dropdown.active),
.product-item-ml:has(.type-dropdown.show),
.grid-item-card:has(.actions-dropdown.is-active),
.grid-item-card:has(.actions-dropdown.active),
.grid-item-card:has(.actions-dropdown.show) {
    z-index: 9999 !important;
}

.actions-menu-container,
.status-toggle-container,
.type-toggle-container,
.receipt-dropdown-wrapper {
    position: relative !important;
}

.actions-dropdown,
.status-dropdown,
.type-dropdown {
    z-index: 10000 !important;
}

/* Elevamos la fila/tarjeta entera cuando tiene un menú abierto o el cursor encima */
.table-item-ml:hover,
.product-item-ml:hover,
.grid-item-card:hover,
.table-item-ml:focus-within,
.product-item-ml:focus-within,
.grid-item-card:focus-within,
.table-item-ml:has(.actions-dropdown.is-active),
.table-item-ml:has(.actions-dropdown.show),
.product-item-ml:has(.actions-dropdown.is-active),
.product-item-ml:has(.status-dropdown.is-active),
.product-item-ml:has(.type-dropdown.is-active),
.grid-item-card:has(.actions-dropdown.is-active),
.grid-item-card.menu-active {
    z-index: 999 !important;
}

.actions-menu-container,
.status-toggle-container,
.type-toggle-container,
.receipt-dropdown-wrapper {
