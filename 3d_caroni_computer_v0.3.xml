/* ==========================================================================
   PRODUCT DETAIL V2 (Diseño Compacto, Alineaciones y Ajustes Responsivos)
   ========================================================================== */

/* 1. CORRECCIÓN DE MÁRGENES: Quitamos el límite de ancho al contenedor 
   para que el margen hacia la pantalla sea exactamente el que definamos */
.lvr-product-page-wrapper .container {
    padding-left: 0 !important;
    padding-right: 0 !important;
