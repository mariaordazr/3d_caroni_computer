}
.lvr-stock-pill.in-stock { background-color: var(--lvr-success-soft); color: var(--lvr-success); }
.lvr-stock-pill.in-stock .dot { width: 6px; height: 6px; border-radius: 50%; background-color: var(--lvr-success); }
.lvr-stock-pill.out-of-stock { background-color: var(--lvr-muted); color: var(--lvr-muted-foreground); }
.lvr-stock-pill.out-of-stock .dot { width: 6px; height: 6px; border-radius: 50%; background-color: var(--lvr-muted-foreground); }

/* Nota de agotado */
.lvr-out-of-stock-note { font-size: 0.8rem; color: #94a3b8; display: block; }

/* Tarjetas Garantía y Condición */
.lvr-quick-features { display: flex; gap: 1rem; margin-bottom: 1.5rem; }
.lvr-qf-box { display: flex; align-items: center; gap: 0.75rem; border: 1px solid #eaeaea; border-radius: 0.75rem; padding: 0.85rem 1rem; flex: 1; }
.lvr-qf-box i { font-size: 1.4rem; color: var(--lvr-primary); background: #f8fafc; padding: 0.5rem; border-radius: 50%; }
.lvr-qf-box span { display: block; font-size: 0.75rem; color: var(--lvr-muted-foreground); }
.lvr-qf-box strong { display: block; font-size: 0.95rem; font-weight: 600; color: var(--lvr-foreground); }

/* Sección Comprar y Cantidad */
.lvr-action-section { margin-bottom: 1rem; }
.lvr-qty-label { font-size: 0.85rem; font-weight: 600; color: var(--lvr-foreground); margin-bottom: 0.5rem; display: block; }
.lvr-action-row { display: flex; align-items: stretch; gap: 1rem; margin-bottom: 0.5rem; }
.lvr-qty-selector { display: flex; align-items: center; border: 1px solid #eaeaea; border-radius: 9999px; overflow: hidden; background: #fff; }
.lvr-qty-btn { background: transparent; border: none; padding: 0.5rem 1rem; cursor: pointer; color: var(--lvr-muted-foreground); font-size: 1.2rem; transition: color 0.2s; }
.lvr-qty-btn:hover { color: var(--lvr-foreground); }
.lvr-qty-selector input { width: 45px; text-align: center; border: none; font-weight: 600; font-size: 1rem; color: var(--lvr-foreground); appearance: textfield; -moz-appearance: textfield; outline: none; }
.lvr-qty-selector input::-webkit-outer-spin-button, .lvr-qty-selector input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

.lvr-btn-whatsapp { flex: 1; border-radius: 9999px !important; background-color: var(--lvr-success) !important; border: none !important; padding: 0 !important; overflow: hidden; box-shadow: 0 4px 12px rgba(34,197,94,0.2) !important; transition: transform 0.2s, box-shadow 0.2s; }
.lvr-btn-whatsapp:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(34,197,94,0.3) !important; }
.lvr-btn-whatsapp a { display: flex; justify-content: center; align-items: center; width: 100%; height: 100%; padding: 0.85rem 1rem; font-size: 0.95rem; font-weight: 600; color: white !important; gap: 0.5rem; text-decoration: none; }
.lvr-btn-whatsapp i { font-size: 1.3rem; }

.lvr-response-time { font-size: 0.75rem; color: var(--lvr-muted-foreground); display: flex; align-items: center; gap: 0.35rem; }
.lvr-response-time i { font-size: 0.9rem; }

/* Beneficios */
.lvr-benefits-box { background-color: #fff8f1; border-radius: 1rem; padding: 1.25rem; margin-top: 1rem; }
.lvr-benefits-box ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
.lvr-benefits-box li { font-size: 0.85rem; font-weight: 500; color: #9a3412; display: flex; align-items: center; gap: 0.75rem; }
.lvr-benefits-box li i { font-size: 1.2rem; }

/* ==========================================================================
   TABS (Pestañas - Características y Más Info)
   ========================================================================== */
.lvr-tabs-header { 
    display: flex; 
    gap: 2.5rem; 
    border-bottom: 1px solid #eaeaea; 
    margin-bottom: 2rem; 
    justify-content: center; /* ¡AQUÍ ESTÁ LA MAGIA! Centra los botones horizontalmente */
}
.lvr-tab-btn { background: transparent; border: none; padding: 0 0 0.75rem 0; font-family: var(--lvr-font-sans); font-size: 1.05rem; font-weight: 600; color: var(--lvr-muted-foreground); cursor: pointer; position: relative; transition: color 0.3s; }
.lvr-tab-btn:hover { color: var(--lvr-foreground); }
.lvr-tab-btn.active { color: var(--lvr-foreground); }
.lvr-tab-btn.active::after { content: ''; position: absolute; bottom: -1px; left: 0; width: 100%; height: 3px; background-color: var(--lvr-foreground); border-radius: 3px 3px 0 0; }
.lvr-tab-pane { display: none; animation: fadeInTab 0.4s ease; }
.lvr-tab-pane.active { display: block; }
@keyframes fadeInTab { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }


.product-extended-description { font-size: 0.95rem; color: var(--lvr-muted-foreground); line-height: 1.7; }

/* ==========================================================================
   Estilos Tabla Especificaciones (Alineación Derecha - Izquierda)
   ========================================================================== */
.lvr-features-container { display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 1rem; }
.lvr-feature-text { font-size: 0.95rem; color: var(--lvr-muted-foreground); line-height: 1.6; margin: 0 0 0.5rem 0; text-align: left; }

.lvr-specs-table { 
    width: 100%; 
    border-collapse: collapse; 
    margin-bottom: 0.5rem; 
}

/* Lo que está ANTES de los dos puntos (Lado Izquierdo) */
.lvr-specs-table th { 
    padding: 0.85rem 1.5rem; /* Margen interno para que no choquen en el centro */
    border-bottom: 1px solid #eaeaea; 
    color: var(--lvr-muted-foreground); 
    font-weight: 500; 
    width: 50%; 
    font-size: 0.95rem; 
    text-align: right !important; /* Alineado a la Derecha */
}

/* Lo que está DESPUÉS de los dos puntos (Lado Derecho) */
.lvr-specs-table td { 
    padding: 0.85rem 1.5rem; 
    border-bottom: 1px solid #eaeaea; 
    color: var(--lvr-foreground); 
    font-weight: 600; 
    width: 50%; 
    font-size: 0.95rem; 
    text-align: left !important; /* Alineado a la Izquierda */
}

.lvr-specs-table tr:last-child th, 
.lvr-specs-table tr:last-child td { 
    border-bottom: none; 
}
/* ==========================================================================
   RESPONSIVE (Para Tablet y Móvil)
   ========================================================================== */

/* TABLET (~1024px) */
@media (max-width: 1024px) {
    .product-detail-layout { 
        grid-template-columns: 1fr !important; /* Pasa a 1 sola columna */
        gap: 2rem !important; 
    }
    
    .product-gallery {
        display: grid;
        grid-template-columns: 80px 1fr;
        gap: 1.5rem;
    }
    
    .lvr-breadcrumb-title { max-width: 400px; }
    
    /* 1. CORRECCIÓN PRINCIPAL: Permitimos que los contenedores ocupen el 100% (stretch) */
    .product-info {
        align-items: stretch !important; 
    }
    
    /* Alineamos a la izquierda solo los textos, no las cajas completas */
    .product-info__title, 
    .lvr-sku-text, 
    .lvr-info-header,
    .product-extended-description {
        text-align: left !important;
    }

    .product-info__price {
        justify-content: flex-start !important;
    }
}

/* MÓVIL (<768px) */
@media (max-width: 768px) {
    .lvr-card-section { 
        padding: 1.5rem !important; 
        border-radius: 1rem;
        margin-left: 1.2rem !important;
        margin-right: 1.2rem !important;
    }
    
    .product-gallery {
        display: flex !important;
        flex-direction: column !important;
        gap: 1rem;
    }
    
    .gallery-thumbnails {
        flex-direction: row !important;
        order: 2;
        overflow-x: auto;
        justify-content: center;
        padding-bottom: 0.5rem;
    }
    .gallery-main-image { order: 1; }
    
    .lvr-breadcrumb-detail {
        margin-left: 1.35rem !important;
        margin-right: 1.35rem !important;
    }
    .lvr-breadcrumb-title { max-width: 150px; }
    
    /* Ajustes de tipografía para móvil */
    .product-info__title { font-size: 1.25rem !important; }
    .offer-price { font-size: 1.125rem !important; }
    .offer-price small { font-size: 0.9rem; }
    .original-price { font-size: 0.9rem !important; }
    .lvr-stock-pill { font-size: 0.75rem; padding: 0.25rem 0.6rem !important; }
}

/* MÓVIL PEQUEÑO (<600px) */
@media (max-width: 600px) {
    /* 2. Cajas de Garantía y Condición: lado a lado pero llenando el 100% */
    .lvr-quick-features { 
        flex-direction: row; 
        gap: 0.5rem; 
    }
    .lvr-qf-box { 
        padding: 0.75rem 0.5rem; 
        flex: 1; /* Esto obliga a ambas cajas a repartirse el espacio 50/50 */
        justify-content: center; 
    }
    
    /* 3. Selector de cantidad y Botón WhatsApp: apilados al 100% de ancho */
    .lvr-action-row { 
        flex-direction: column; 
        align-items: stretch; 
        gap: 0.75rem;
    }
    .lvr-qty-selector { 
        justify-content: space-between; 
        width: 100%; /* Ocupa todo el ancho */
        padding: 0.25rem 1rem;
    } 
    
    /* Corrección milimétrica de alineación para la tabla de características en móviles */
    .lvr-specs-table th, .lvr-specs-table td { 
        display: block; 
        width: 100% !important; 
        padding: 0.25rem 0 !important; 
        border: none; 
        text-align: left !important;
    }
    .lvr-specs-table td { 
        border-bottom: 1px solid #eaeaea; 
        margin-bottom: 0.5rem; 
    }
}

/* ==========================================================================
   NUEVO DISEÑO DE LOGIN (lvr-login)
   ========================================================================== */

/* Fondo oscuro completo que reemplaza los estilos previos del body */
.lvr-login-body {
    background-color: #131e32 !important; /* Azul oscuro corporativo */
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--lvr-font-sans), sans-serif;
    margin: 0;
    padding: 1rem;
}

/* Contenedor principal para centrar la tarjeta y los textos inferiores */
.lvr-login-wrapper {
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* Tarjeta Blanca Principal */
.lvr-login-card {
    background-color: #ffffff;
    width: 100%;
    border-radius: 1.5rem;
    padding: 3rem 2.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    display: flex;
