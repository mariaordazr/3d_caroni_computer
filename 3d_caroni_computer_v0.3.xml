    max-width: 200px;
}

.service-card .btn:hover {
    background-color: var(--color-accent);
}

/* --- Sección Inferior (Contenido Extra / Video) --- */
.content-section {
    max-width: 900px;
    margin: 0 auto 4rem auto; /* Centrado horizontal */
    padding: 0 var(--container-padding);
    text-align: center;
}

.content-section h2 {
    font-family: var(--font-titles);
