<file path="public/assets/admin/js/admin-home.js">
document.addEventListener('DOMContentLoaded', function() {
    
    // --- 1. VARIABLES GLOBALES PARA EL CROPPER ---
    let cropper = null;
    let currentFileInput = null; // Guardará cuál input se está editando
    let currentPreviewCallback = null; // Guardará la función para actualizar la vista previa
    
    // Obtener elementos del DOM
    const modal = document.getElementById('crop-modal');
    const imageToCrop = document.getElementById('image-to-crop');
    const btnCrop = document.getElementById('btn-crop-confirm');
    const btnCancel = document.getElementById('btn-cancel-crop');
    const modalTitle = document.getElementById('crop-modal-title');

    // Validación de seguridad: Si no existe el modal en el HTML, detener ejecución para evitar errores
    if (!modal || !imageToCrop) {
        console.error("Error: No se encontró el elemento #crop-modal o #image-to-crop en admin-home.php");
        return; 
    }

    // --- 2. FUNCIONES DEL MODAL DE RECORTE ---

    function closeModal() {
        modal.style.display = 'none';
        if (cropper) {
            cropper.destroy();
            cropper = null;
        }
        currentFileInput = null;
        imageToCrop.src = '';
    }

    function cancelCrop() {
        if(currentFileInput) {
            currentFileInput.value = ''; // Borrar el archivo del input si cancela
        }
        closeModal();
    }

    // Eventos del Modal
    if(btnCancel) {
        btnCancel.addEventListener('click', function(e) {
            e.preventDefault();
            cancelCrop();
        });
    }

    // Cerrar al dar clic fuera del modal
    modal.addEventListener('click', function(e) {
        if (e.target === modal) cancelCrop();
    });

    if(btnCrop) {
        btnCrop.addEventListener('click', function() {
            if (!cropper) return;

            // Obtener canvas recortado
            const canvas = cropper.getCroppedCanvas({
                width: 1920, // Calidad alta para sliders
                imageSmoothingQuality: 'high'
            });

            canvas.toBlob(function(blob) {
                // Crear archivo nuevo reemplazando el original
                const croppedFile = new File([blob], "banner_home_recortado.webp", { type: "image/webp" });
                
                // Reemplazar en el input original
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(croppedFile);
                currentFileInput.files = dataTransfer.files;

                // Ejecutar la vista previa en el slot correspondiente
                if (currentPreviewCallback) {
                    currentPreviewCallback(croppedFile);
                }

                closeModal();
            }, 'image/webp', 0.95);
        });
    }


    // --- 3. LÓGICA DE GESTIÓN DE SLOTS (Home) ---

    function resyncSlotNames() {
        const slots = document.querySelectorAll('.image-slot');
        slots.forEach((slot, newIndex) => {
            
            // 1. Actualiza la etiqueta visual
            const label = slot.querySelector('.slot-order-label');
            if (label) {
                label.textContent = `${newIndex + 1}`;
            }

            // 2. Renombra el label for
            const labelElement = slot.querySelector('label');
            if (labelElement) {
                labelElement.setAttribute('for', `image-slot-${newIndex}`);
            }

            // 3. Renombra el input file
            const fileInput = slot.querySelector('input[type="file"]');
            if (fileInput) {
                fileInput.setAttribute('name', `image_slot_${newIndex}`);
                fileInput.setAttribute('id', `image-slot-${newIndex}`);
            }

            // 4. Renombra el input hidden delete (CORREGIDO: delete_slot_)
            // Busca input que empiece por delete_slot_ O delete_image_ para ser compatible
            const deleteInput = slot.querySelector('input.delete-slot-flag');
            if (deleteInput) {
                deleteInput.setAttribute('name', `delete_slot_${newIndex}`);
            }
            
            // 5. Renombra el input hidden ID
            const imageIdInput = slot.querySelector('input.slot-image-id');
            if (imageIdInput) {
                imageIdInput.setAttribute('name', `slot_image_id_${newIndex}`);
            }
        });
    }

    // Lógica de intercambio (Swap)
    document.querySelectorAll('.btn-swap-slot').forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            const parent = this.parentNode;
            const slotLeft = this.previousElementSibling;
            const slotRight = this.nextElementSibling;
            
            if (slotLeft && slotLeft.classList.contains('image-slot') &&
                slotRight && slotRight.classList.contains('image-slot')) {
                
                parent.insertBefore(slotRight, slotLeft);
                parent.insertBefore(this, slotLeft);
                resyncSlotNames();
            }
        });
    });

    /**
     * Inicializa la previsualización y el recorte para un slot.
     */
    function initializeSlot(slot) {
        
        const fileInput = slot.querySelector(`input[type="file"]`);
        const label = slot.querySelector('label');
        
        // CORREGIDO: Usar clase .delete-slot-flag para ser más seguro
        const deleteInput = slot.querySelector(`input.delete-slot-flag`);
        const imageIdInput = slot.querySelector(`input.slot-image-id`);
        
        const initialDeleteBtn = label.querySelector('.remove-preview-btn');
        let currentPreviewFrame = label.querySelector('.image-preview-slot-frame');
        
        // --- Función para mostrar la preview (Callback) ---
        function showPreview(file) {
            if (currentPreviewFrame) currentPreviewFrame.remove();
            
            const placeholder = label.querySelector('.image-placeholder-slot');
            const reader = new FileReader();

            reader.onload = function(e) {
                if (placeholder) placeholder.style.display = 'none';
                slot.classList.add('has-preview');

                const frame = document.createElement('div');
                frame.classList.add('image-preview-slot-frame');
                const img = document.createElement('img');
                img.classList.add('image-preview-slot');
                img.src = e.target.result;
                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.classList.add('remove-preview-btn');
                removeBtn.innerHTML = '<i class="bx bx-x"></i>';
                
                removeBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    removeFrame(frame);
                    fileInput.value = null; 
                });

                frame.appendChild(img);
                frame.appendChild(removeBtn);
                label.appendChild(frame);
                currentPreviewFrame = frame;
                
                // Resetear flags de borrado
                if (deleteInput) deleteInput.value = "0"; 
                if (imageIdInput) imageIdInput.value = ""; 
            }
            reader.readAsDataURL(file);
        }

        // --- Función para limpiar ---
        function removeFrame(frame) {
            if (frame) frame.remove();
            let existingPlaceholder = label.querySelector('.image-placeholder-slot');
            
            if (!existingPlaceholder) {
                const newPlaceholder = document.createElement('div');
                newPlaceholder.classList.add('image-placeholder-slot');
                newPlaceholder.innerHTML = "<i class='bx bx-plus'></i>";
                label.appendChild(newPlaceholder);
            } else {
                existingPlaceholder.style.display = 'flex';
            }
            
            slot.classList.remove('has-preview');
        }

        // --- ASIGNAR EVENTOS CON RECORTE ---
        fileInput.addEventListener('change', function(event) {
            if (event.target.files && event.target.files.length > 0) {
                const file = event.target.files[0];

                // Validar que sea imagen
                if (!file.type.startsWith('image/')) return;

                // Definir proporción: Home Slider (0-4) y Banner Secundario (5) son 4:1
                const targetAspectRatio = 4 / 1; 
                const titleText = "Recortar Imagen Panorámica (4:1)";

                // Preparar variables globales
                currentFileInput = fileInput;
                currentPreviewCallback = showPreview;
                
                // Abrir Modal
                const reader = new FileReader();
                reader.onload = function(evt) {
                    imageToCrop.src = evt.target.result;
                    modal.style.display = 'flex'; // Mostrar modal
                    if(modalTitle) modalTitle.innerText = titleText;

                    // Iniciar Cropper
                    if (cropper) cropper.destroy();
                    cropper = new Cropper(imageToCrop, {
                        aspectRatio: targetAspectRatio, 
                        viewMode: 1,
                        autoCropArea: 1,
                    });
                };
                reader.readAsDataURL(file);
            }
        });

        // Evento botón borrar existente
        if (initialDeleteBtn) {
            initialDeleteBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                // Marcar para borrar (Value "1" o "DELETE")
                if (deleteInput) deleteInput.value = "1";
                
                removeFrame(currentPreviewFrame);
                currentPreviewFrame = null;
                fileInput.value = null;
            });
        }
    }
    
    // Inicializar todos los slots
    document.querySelectorAll('.image-slot').forEach(slot => {
        initializeSlot(slot);
    });
    
    
    // --- LÓGICA DE VALIDACIÓN Y LÍMITE DE CHECKBOXES (Categorías/Marcas) ---

    const MAX_ITEMS = 7;
    const $categoryCheckboxes = $('input[name="featured_categories[]"]');
    const $brandCheckboxes = $('input[name="featured_brands[]"]');
    const $mainSubmitButton = $('form.edit-form').find('button[type="submit"].btn-primary');
    
    const $categoryErrorMessage = $('#categories-error-message'); 
    const $brandErrorMessage = $('#brands-error-message'); 

    function validateFeaturedItems() {
        const catCount = $categoryCheckboxes.filter(':checked').length;
        const brandsExist = $brandCheckboxes.length > 0; 
        const brandCount = $brandCheckboxes.filter(':checked').length;

        let categoriesValid = catCount === MAX_ITEMS;
        let brandsValid = brandsExist ? (brandCount === MAX_ITEMS) : true;
        
        // Validar Categorías
        if (catCount >= MAX_ITEMS) {
            $categoryCheckboxes.not(':checked').prop('disabled', true).closest('.form-check').addClass('disabled-item');
        } else {
            $categoryCheckboxes.prop('disabled', false).closest('.form-check').removeClass('disabled-item');
        }
        
        // Validar Marcas
        if (brandsExist) {
            if (brandCount >= MAX_ITEMS) {
                $brandCheckboxes.not(':checked').prop('disabled', true).closest('.form-check').addClass('disabled-item');
            } else {
                $brandCheckboxes.prop('disabled', false).closest('.form-check').removeClass('disabled-item');
            }
            $brandErrorMessage.toggle(!brandsValid);
        }

        $categoryErrorMessage.toggle(!categoriesValid);
        $mainSubmitButton.prop('disabled', !(categoriesValid && brandsValid));
    }

    $categoryCheckboxes.on('change', validateFeaturedItems);
    $brandCheckboxes.on('change', validateFeaturedItems);
    
    validateFeaturedItems();

});
</file>

<file path="public/assets/admin/js/admin-shipping-preview.js">
document.addEventListener('DOMContentLoaded', function() {
    const previewModal = document.getElementById('preview-modal');
    const btnOpen = document.getElementById('btn-open-preview');
    const btnClose = document.getElementById('btn-close-preview');

    function updatePreviewData() {
        // 1. TEXTOS
        // Shipping tiene índices 0 (Envíos) y 1 (Local)
        for (let i = 0; i <= 1; i++) {
            const inputTitle = document.querySelector(`input[name="shipping_title_${i}"]`);
            const previewTitle = document.getElementById(`preview-title-${i}`);
            if(inputTitle && previewTitle) previewTitle.innerText = inputTitle.value;

            const inputText = document.querySelector(`textarea[name="shipping_text_${i}"]`);
            const previewText = document.getElementById(`preview-text-${i}`);
            if(inputText && previewText) {
                previewText.innerHTML = inputText.value.replace(/\n/g, '<br>');
            }
        }

        // 2. IMÁGENES
        // Banner (slot 0)
        updateImagePreview(0, 'preview-banner-bg', true);
        // Local (slot 1)
        updateImagePreview(1, 'preview-img-1', false);

        // 3. MARCAS (Dynamic Slots)
        updateBrandsPreview();

        // 4. MAPA
        updateMapPreview();
    }

    function updateImagePreview(slotIndex, targetId, isBackground) {
        const fileInput = document.querySelector(`input[name="image_slot_${slotIndex}"]`);
        const existingImg = document.querySelector(`input[name="slot_image_id_${slotIndex}"]`);
        const targetEl = document.getElementById(targetId);
        
        if (!targetEl) return;
        const basePath = (slotIndex === 0) ? '/assets/uploads/shipping/banner/' : '/assets/uploads/shipping/body/';

        if (fileInput && fileInput.files && fileInput.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                if(isBackground) {
                    targetEl.style.backgroundImage = `url('${e.target.result}')`;
                } else {
                    targetEl.src = e.target.result;
                    targetEl.style.display = 'block';
                }
            }
            reader.readAsDataURL(fileInput.files[0]);
        } else if (existingImg && existingImg.value) {
            const fullPath = basePath + existingImg.value;
            if(isBackground) {
                targetEl.style.backgroundImage = `url('${fullPath}')`;
            } else {
                targetEl.src = fullPath;
                targetEl.style.display = 'block';
            }
        } else {
            if(!isBackground) targetEl.style.display = 'none';
        }
    }

    function updateBrandsPreview() {
        const container = document.getElementById('preview-brands-container');
        container.innerHTML = ''; 

        // Buscar slots en brands-container
        const brandSlots = document.querySelectorAll('#brands-container .image-slot');

        brandSlots.forEach(slot => {
            if(slot.id === 'btn-add-brand') return;

            const fileInput = slot.querySelector('input[type="file"]');
            const hiddenInput = slot.querySelector('input.slot-image-id');
            const deleteInput = slot.querySelector('input.delete-slot-flag');

            if(deleteInput && deleteInput.value === 'DELETE') return;

            let src = null;
            if (fileInput && fileInput.files && fileInput.files[0]) {
                src = URL.createObjectURL(fileInput.files[0]);
            } else if (hiddenInput && hiddenInput.value) {
                src = '/assets/uploads/shipping/body/' + hiddenInput.value;
            }

            if (src) {
                const img = document.createElement('img');
                img.src = src;
                img.style.height = '60px';
                img.style.width = 'auto';
                img.style.objectFit = 'contain';
                container.appendChild(img);
            }
        });
    }

    function updateMapPreview() {
        const inputMap = document.querySelector('input[name="shipping_link"]');
        const iframe = document.getElementById('preview-map-iframe');
        const container = document.getElementById('preview-map-container');

        if (inputMap && inputMap.value.trim() !== '') {
            iframe.src = inputMap.value;
            container.style.display = 'block';
        } else {
            container.style.display = 'none';
        }
    }

    if(btnOpen) {
        btnOpen.addEventListener('click', function() {
            updatePreviewData();
            previewModal.style.display = 'block';
            document.body.style.overflow = 'hidden'; 
        });
    }

    if(btnClose) {
        btnClose.addEventListener('click', function() {
            previewModal.style.display = 'none';
            document.body.style.overflow = 'auto';
        });
    }
});
</file>

<file path="public/assets/admin/js/admin.js">
document.addEventListener('DOMContentLoaded', function() {

    // ==================================================================
    // 0. LÓGICA DE RESTAURACIÓN DE SCROLL Y TOASTS
    // ==================================================================
    
    // 1. Restaurar Scroll
    const scrollPosition = sessionStorage.getItem('scrollPosition');
    if (scrollPosition) {
        window.scrollTo(0, parseInt(scrollPosition));
        sessionStorage.removeItem('scrollPosition');
    }

    // 2. Mostrar Toast pendiente (si venimos de una recarga AJAX)
    const pendingToast = sessionStorage.getItem('pendingToast');
    if (pendingToast) {
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-start',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.onmouseenter = Swal.stopTimer;
                toast.onmouseleave = Swal.resumeTimer;
            }
        });

        Toast.fire({
            icon: 'success',
            title: pendingToast
        });
        sessionStorage.removeItem('pendingToast');
    }
    

    // ==================================================================
    // 1. LÓGICA DEL SIDEBAR (ESCRITORIO Y MÓVIL)
    // ==================================================================
    const sidebar = document.querySelector('.sidebar');
    const sidebarToggle = document.getElementById('sidebar-toggle'); 
    const mobileToggle = document.getElementById('mobile-menu-toggle'); 
    const mobileClose = document.getElementById('sidebar-close-mobile'); 

    // --- A. Lógica Escritorio (Colapsar) ---
    if (sidebar && sidebarToggle) {
        if (localStorage.getItem('sidebar_collapsed') === 'true' || window.innerWidth <= 992) {
            sidebar.classList.add('sidebar--collapsed');
            document.documentElement.setAttribute('data-sidebar', 'collapsed');
        }
        sidebarToggle.addEventListener('click', () => {
            const isNowCollapsed = sidebar.classList.toggle('sidebar--collapsed');
            document.documentElement.setAttribute('data-sidebar', isNowCollapsed ? 'collapsed' : 'expanded');
            localStorage.setItem('sidebar_collapsed', isNowCollapsed);
        });
    }

    // --- B. Lógica Móvil (Off-Canvas) ---
    let overlay = document.querySelector('.sidebar-overlay');
    if (!overlay) {
        overlay = document.createElement('div');
        overlay.className = 'sidebar-overlay';
        document.body.appendChild(overlay);
    }

    function openMobileMenu() {
        if (sidebar) sidebar.classList.add('mobile-active');
        if (overlay) overlay.classList.add('active');
        document.body.style.overflow = 'hidden'; 
    }

    function closeMobileMenu() {
        if (sidebar) sidebar.classList.remove('mobile-active');
        if (overlay) overlay.classList.remove('active');
        document.body.style.overflow = ''; 
    }

    if (mobileToggle) {
        mobileToggle.addEventListener('click', (e) => {
            e.preventDefault();
            openMobileMenu();
        });
    }

    if (mobileClose) {
        mobileClose.addEventListener('click', (e) => {
            e.preventDefault();
            closeMobileMenu();
        });
    }

    if (overlay) {
        overlay.addEventListener('click', closeMobileMenu);
    }

    window.addEventListener('resize', () => {
        if (window.innerWidth > 768) {
            closeMobileMenu();
        }
    });


    // ==================================================================
    // 2. LÓGICA DE FILTRADO (BUSCADOR)
    // ==================================================================
    const filterForm = document.getElementById('filter-form');
    if (filterForm) {
        const searchInput = filterForm.querySelector('input[name="search"]');
        
        if (searchInput) {
            searchInput.addEventListener('keydown', (e) => {
                // e.keyCode === 13 asegura la captura en teclados móviles donde e.key falla
                if (e.key === 'Enter' || e.keyCode === 13) {
                    
                    // Condicionar para que aplique su lógica específica en móviles
                    if (window.innerWidth <= 768) {
                        e.preventDefault(); // Previene que el navegador salte al siguiente campo
                        filterForm.submit(); // Fuerza la búsqueda de inmediato
                    } else {
                        // Mantiene el comportamiento habitual en pantallas de escritorio
                        e.preventDefault();
                        filterForm.submit();
                    }
                }
            });
        }
                
        // Envía el formulario al cambiar select o checkboxes
        filterForm.querySelectorAll('select, input[type="checkbox"]').forEach(input => {
            input.addEventListener('change', () => {
                filterForm.submit();
            });
        });
    }

    
    // ==================================================================
    // 3. LÓGICA DE VISTA (LISTA VS CUADRÍCULA) SIN PARPADEO
    // ==================================================================
    const btnViewList = document.getElementById('btn-view-list');
    const btnViewGrid = document.getElementById('btn-view-grid');
    const productViewContainer = document.querySelector('.product-view-container');

    if (btnViewList && btnViewGrid && productViewContainer) {
        const preferredView = localStorage.getItem('product_view') || 'list';
        document.documentElement.setAttribute('data-view', preferredView);
        
        if (preferredView === 'grid') {
            productViewContainer.classList.remove('view-list');
            productViewContainer.classList.add('view-grid');
            btnViewList.classList.remove('is-active');
            btnViewGrid.classList.add('is-active');
        } else {
            productViewContainer.classList.remove('view-grid');
            productViewContainer.classList.add('view-list');
            btnViewGrid.classList.remove('is-active');
            btnViewList.classList.add('is-active');
        }

        btnViewList.addEventListener('click', () => {
            document.documentElement.setAttribute('data-view', 'list');
            productViewContainer.classList.remove('view-grid');
            productViewContainer.classList.add('view-list');
            btnViewGrid.classList.remove('is-active');
            btnViewList.classList.add('is-active');
            localStorage.setItem('product_view', 'list');
        });

        btnViewGrid.addEventListener('click', () => {
            document.documentElement.setAttribute('data-view', 'grid');
            productViewContainer.classList.remove('view-list');
            productViewContainer.classList.add('view-grid');
            btnViewList.classList.remove('is-active');
            btnViewGrid.classList.add('is-active');
            localStorage.setItem('product_view', 'grid');
        });
    }
    
    // Toggle filtros móvil
    const toggleBtn = document.getElementById('mobile-filter-toggle');
    const filterControls = document.getElementById('filter-controls-container');
    
    if(toggleBtn && filterControls) {
        toggleBtn.addEventListener('click', function() {
            filterControls.classList.toggle('is-visible');
            toggleBtn.classList.toggle('is-active');
        });
    }
});

// ==================================================================
// 4. LÓGICA DE MENÚS DESPLEGABLES (DROPDOWNS)
// ==================================================================
document.addEventListener('click', function(event) {
    
    if (!event.target.closest('.actions-menu-toggle, .stock-toggle-btn, .type-toggle-btn')) {
        closeAllDropdowns();
    }

    // --- A. Menú de ACCIONES ---
    const actionsToggle = event.target.closest('.actions-menu-toggle');
    if (actionsToggle) {
        event.stopPropagation();
        const dropdown = actionsToggle.nextElementSibling;
        closeAllDropdowns('.actions-dropdown, .status-dropdown, .type-dropdown', dropdown);
        dropdown.classList.toggle('is-active');
        return;
    }

    // --- B. Menú de ESTADO ---
    const stockToggle = event.target.closest('.stock-toggle-btn');
    if (stockToggle) {
        event.stopPropagation();
        const dropdown = stockToggle.nextElementSibling;
        closeAllDropdowns('.actions-dropdown, .status-dropdown, .type-dropdown', dropdown);
        dropdown.classList.toggle('is-active');
        return;
    }
    const stockOption = event.target.closest('.stock-option');
    if (stockOption) {
        event.preventDefault();
        event.stopPropagation();
        handleStockOptionClick(stockOption);
        return;
    }

    // --- C. Menú de TIPO ---
    const typeToggle = event.target.closest('.type-toggle-btn');
    if (typeToggle) {
        event.stopPropagation();
        const dropdown = typeToggle.nextElementSibling;
        closeAllDropdowns('.actions-dropdown, .status-dropdown, .type-dropdown', dropdown);
        dropdown.classList.toggle('is-active');
        return;
    }
    const typeOption = event.target.closest('.type-option');
    if (typeOption) {
        event.preventDefault();
        event.stopPropagation();
        handleTypeOptionClick(typeOption);
        return;
    }

    // ==================================================================
    // 5. LÓGICA DE ELIMINACIÓN
    // ==================================================================
    const deleteButton = event.target.closest('.btn-delete');
    if (deleteButton) {
        event.preventDefault();
        event.stopPropagation();
        const deleteUrl = deleteButton.getAttribute('href'); 
        
        if (deleteUrl.includes('/admin/products/')) {
            showSimpleDeleteConfirmation(deleteUrl);
        } else if (deleteUrl.includes('/admin/categories/')) {
            showAdvancedDeleteConfirmation(deleteUrl, 'categoría');
        } else if (deleteUrl.includes('/admin/brands/')) {
            showAdvancedDeleteConfirmation(deleteUrl, 'marca');
        } else {
            showSimpleDeleteConfirmation(deleteUrl);
        }
    }
});

// ==================================================================
// 6. FUNCIONES AUXILIARES
// ==================================================================

// --- NUEVA FUNCIÓN: Recargar guardando el scroll ---
function reloadWithScroll() {
    sessionStorage.setItem('scrollPosition', window.scrollY);
    location.reload();
}

function closeAllDropdowns(selector = '.actions-dropdown, .status-dropdown, .type-dropdown', exclude = null) {
    document.querySelectorAll(selector).forEach(dropdown => {
        if (dropdown !== exclude) {
            dropdown.classList.remove('is-active');
        }
    });
}

function handleStockOptionClick(optionElement) {
    const dropdown = optionElement.closest('.status-dropdown');
    const button = dropdown.previousElementSibling;
    const productId = button.getAttribute('data-product-id');
    const newStockValue = optionElement.getAttribute('data-stock-value'); 

    if (newStockValue === '0') {
        updateStatus(productId, 0);
    } else {
        Swal.fire({
            title: 'Actualizar Stock',
            text: 'Ingresa la nueva cantidad de unidades:',
            input: 'number',
            inputAttributes: { min: 1, step: 1 },
            showCancelButton: true,
            confirmButtonText: 'Actualizar',
            cancelButtonText: 'Cancelar',
            preConfirm: (value) => {
                if (!value || value < 1 || !Number.isInteger(Number(value))) {
                    Swal.showValidationMessage('Por favor, ingresa un número entero positivo.');
                    return false;
                }
                return value;
            }
        }).then((result) => {
            if (result.isConfirmed) {
                updateStatus(productId, result.value);
            }
        });
    }
}

function handleTypeOptionClick(optionElement) {
    const type = optionElement.getAttribute('data-type');
    const container = optionElement.closest('.type-toggle-container');
    const button = container.querySelector('.type-toggle-btn');
    const productId = button.getAttribute('data-product-id');
    
    if (type === 'offer') {
        Swal.fire({
            title: 'Establecer Precio de Oferta',
            input: 'number',
            inputAttributes: { step: '0.01', placeholder: '0.00' },
            showCancelButton: true,
            confirmButtonText: 'Guardar',
            cancelButtonText: 'Cancelar',
            preConfirm: (value) => {
                if (!value || isNaN(value) || value <= 0) {
                    Swal.showValidationMessage('Por favor, ingresa un precio válido y positivo.');
                    return false;
                }
                return value;
            }
        }).then((result) => {
            if (result.isConfirmed) {
                updateProductType(productId, 'offer', result.value);
            }
        });
    } else {
        updateProductType(productId, type);
    }
}

function updateStatus(productId, stockValue) {
    fetch('/admin/updateProductStatus', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `product_id=${productId}&stock_value=${stockValue}`
    }).then(res => res.json()).then(data => {
        if (data.success) {
            // Pasamos el mensaje aquí
            reloadWithScroll('¡Estado actualizado correctamente!'); 
        } else {
            Swal.fire('Error', 'No se pudo actualizar el estado.', 'error');
        }
    });
}

function updateProductType(productId, type, price = 0) {
    const formData = new URLSearchParams();
    formData.append('product_id', productId);
    formData.append('type', type);
    formData.append('price', price);
    fetch('/admin/updateProductType', {
        method: 'POST',
        body: formData
    }).then(res => res.json()).then(data => {
        if (data.success) {
            reloadWithScroll('¡Tipo de producto actualizado!');
        } else {
            Swal.fire('Error', 'No se pudo actualizar el producto.', 'error');
        }
    });
}

function showSimpleDeleteConfirmation(url) {
    Swal.fire({
        title: '¿Estás seguro?',
        text: "¡No podrás revertir esta acción!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Sí, ¡eliminar!',
        cancelButtonText: 'Cancelar'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch(url, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    // En el bloque .then(data => { ...
                    if (data.success) {
                        // Ya no usamos Swal.fire aquí, sino reloadWithScroll con mensaje
                        reloadWithScroll('El registro ha sido eliminado.');
                    } else {
                        Swal.fire('Error', 'No se pudo eliminar el registro.', 'error');
                    }
                });
        }
    });
}

function showAdvancedDeleteConfirmation(url, typeName) {
    const countUrl = url.replace('/delete/', '/productCount/'); 

    fetch(countUrl)
        .then(res => res.json())
        .then(data => {
            if (!data.success) {
                Swal.fire('Error', 'No se pudo obtener el conteo de productos.', 'error');
                return;
            }

            const count = data.count;
            let title = '¿Estás seguro?';
            let text = `Se eliminará esta ${typeName}. ¡No podrás revertir esta acción!`;

            if (count > 0) {
                title = `¡Atención! Esta ${typeName} tiene ${count} producto(s) asociado(s).`;
                text = `Si eliminas esta ${typeName}, todos sus productos asociados también serán borrados permanentemente. ¿Estás seguro de continuar?`;
            }

            Swal.fire({
                title: title,
                text: text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, ¡eliminar todo!',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(url, { method: 'POST' })
                        .then(res => res.json())
                        .then(deleteData => {
                            // En el bloque .then(deleteData => { ...
                            if (deleteData.success) {
                                // Ya no usamos Swal.fire aquí, sino reloadWithScroll con mensaje
                                reloadWithScroll(`La ${typeName} y sus productos han sido eliminados.`);
                            } else {
                                Swal.fire('Error', 'No se pudo completar la eliminación.', 'error');
                            }
                        });
                }
            });
        })
        .catch(() => {
            Swal.fire('Error', 'Error de conexión al verificar productos.', 'error');
        });
}


