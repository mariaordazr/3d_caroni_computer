.lvr-login-badge i {
    font-size: 0.9rem;
    color: var(--lvr-primary);
}

/* Textos de Bienvenida */
.lvr-login-title {
    font-family: var(--lvr-font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.5rem;
    text-align: center;
}

.lvr-login-subtitle {
    font-size: 0.875rem;
    color: #6b7280;
    text-align: center;
    line-height: 1.5;
    margin-bottom: 2rem;
    padding: 0 1rem;
}

/* Formulario */
.lvr-login-form {
    width: 100%;
}

.lvr-input-group {
    margin-bottom: 1.25rem;
}

.lvr-input-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: #374151;
    margin-bottom: 0.5rem;
}

/* Contenedor de Inputs con Iconos */
.lvr-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.lvr-input-icon {
    position: absolute;
    left: 1rem;
    font-size: 1.2rem;
    color: #9ca3af;
}

.lvr-input-wrapper input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.75rem; /* Espacio extra a la izquierda para el icono */
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    font-size: 0.95rem;
    color: #111827;
    background-color: #f9fafb;
    transition: all 0.2s ease;
    font-family: inherit;
}

/* Espacio extra a la derecha para el input de contraseña (para el icono del ojo) */
.lvr-input-wrapper input[type="password"],
.lvr-input-wrapper input[id="clave"] {
    padding-right: 2.75rem; 
}

.lvr-input-wrapper input:focus {
    outline: none;
    border-color: var(--lvr-primary);
    background-color: #ffffff;
    box-shadow: 0 0 0 4px rgba(27, 71, 121, 0.1);
}

.lvr-input-wrapper input::placeholder {
    color: #9ca3af;
    opacity: 0.7;
}

/* Icono para mostrar/ocultar contraseña */
.lvr-toggle-password {
    position: absolute;
    right: 1rem;
    font-size: 1.2rem;
    color: #9ca3af;
    cursor: pointer;
    transition: color 0.2s;
}

.lvr-toggle-password:hover {
    color: var(--lvr-primary);
}

/* Botón Principal */
.lvr-btn-submit {
    width: 100%;
    background-color: var(--lvr-primary);
    color: #ffffff;
    border: none;
    padding: 0.85rem;
    border-radius: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    margin-top: 1rem;
    transition: background-color 0.2s, transform 0.1s;
}

.lvr-btn-submit:hover {
    background-color: #15365d; /* Un tono más oscuro que el primary */
}

.lvr-btn-submit:active {
    transform: scale(0.98);
}

/* Textos del Footer */
.lvr-login-footer {
    text-align: center;
    color: #9ca3af;
}

.lvr-login-footer p {
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
}

.lvr-login-footer small {
    font-size: 0.75rem;
    opacity: 0.7;
}

/* Responsivo para móviles pequeños */
@media (max-width: 480px) {
    .lvr-login-card {
        padding: 2.5rem 1.5rem;
        border-radius: 1rem;
    }
    .lvr-login-title {
        font-size: 1.35rem;
    }
    .lvr-login-subtitle {
        font-size: 0.8rem;
        padding: 0;
    }
}
