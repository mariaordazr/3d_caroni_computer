.lvr-budget-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.15rem;
    margin-bottom: 1.1rem;
}
.lvr-budget-box:last-child { margin-bottom: 0; }

.lvr-budget-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.95rem;
    flex-wrap: wrap;
}

.lvr-budget-box-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--lvr-font-display);
    font-size: 0.88rem;
    font-weight: 700;
    color: #0f172a;
}

.lvr-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
}
.lvr-dot.amber { background: #d97706; }
.lvr-dot.blue  { background: #2563eb; }

.lvr-tag-amber {
    background: #fef3c7;
    color: #b45309;
    font-family: var(--lvr-font-body);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 2px 9px;
    border-radius: 9999px;
}

.lvr-budget-rows-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.lvr-budget-item-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
}

.lvr-budget-row-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
}

.lvr-budget-item-actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    flex-wrap: wrap;
}

.lvr-ask-pill-btn {
    flex: 1;
    max-width: calc(50% - 5px);
    min-width: 135px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    color: #475569;
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    user-select: none;
    transition: all 0.15s;
}
.lvr-ask-pill-btn:hover {
    border-color: #cbd5e1;
    background: #f8fafc;
}
.lvr-ask-pill-btn.is-active {
    background: #eff6ff;
    border-color: #2563eb;
    color: #2563eb;
}

.lvr-budget-box-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 0.9rem;
    padding-top: 0.85rem;
    border-top: 1px solid #e2e8f0;
}

.lvr-budget-footer-label {
    font-size: 0.85rem;
    color: #64748b;
    font-weight: 500;
}

.lvr-budget-footer-amount {
    display: inline-flex;
    align-items: center;
    font-family: var(--lvr-font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
}

/* Sección 4: Los 2 Tipos de Fotos (Iniciales y Proceso) */
.lvr-photos-dual-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
}

.lvr-photo-category-block {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1rem 1.1rem;
}

.lvr-photo-category-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
}

.lvr-photo-category-title {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 0.84rem;
    font-weight: 700;
    color: #0f172a;
}

.lvr-photo-category-badge {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 9999px;
}
.lvr-photo-category-badge.initial {
    background: #e0f2fe;
    color: #0369a1;
}
.lvr-photo-category-badge.process {
    background: #dcfce7;
    color: #15803d;
}

.lvr-receipt-page .image-slots-container.receipt-gallery {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 0.75rem !important;
}

.lvr-receipt-page .image-slot {
    width: 112px !important;
    height: 112px !important;
    border-radius: 14px !important;
}

.lvr-receipt-page .image-slot label {
    border-radius: 14px !important;
    border: 1.5px dashed #cbd5e1 !important;
    background: #ffffff !important;
    transition: border-color 0.2s, background 0.2s !important;
}
.lvr-receipt-page .image-slot label:hover {
    border-color: #2563eb !important;
    background: #eff6ff !important;
}

.lvr-upload-placeholder-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    height: 100%;
    color: #64748b;
    font-size: 0.85rem;
    font-weight: 600;
}
.lvr-upload-placeholder-content i {
    font-size: 1.35rem;
    color: #475569;
}

/* Sección 5: Quill Editor limpio estilo Textarea de Img 1-3 */
.lvr-quill-wrapper .ql-toolbar.ql-snow {
    border: 1px solid #e2e8f0 !important;
    border-bottom: 1px solid #f1f5f9 !important;
    border-radius: 12px 12px 0 0 !important;
    background: #f8fafc !important;
    padding: 6px 10px !important;
}

.lvr-quill-wrapper .ql-container.ql-snow {
    border: 1px solid #e2e8f0 !important;
    border-top: none !important;
    border-radius: 0 0 12px 12px !important;
    font-family: var(--lvr-font-body) !important;
    font-size: 0.85rem !important;
    min-height: 115px !important;
    background: #ffffff !important;
}

.lvr-quill-wrapper .ql-editor {
    min-height: 115px !important;
}

/* Zona Privada */
.lvr-private-card {
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 18px;
    padding: 1.5rem;
}

.lvr-private-card .lvr-step-icon-wrap {
    background: #ffffff;
    color: #dc2626;
    border: 1px solid #fecaca;
}

.lvr-private-card .lvr-step-titles h3 {
    color: #dc2626;
}

.lvr-private-card .lvr-step-titles p {
    color: #ef4444;
}

/* Panel Resumen (Derecha en PC, Abajo en Tablet/Móvil) */
.lvr-summary-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 1.35rem;
    box-shadow: var(--lvr-shadow-soft);
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
}

.lvr-summary-title {
    font-family: var(--lvr-font-display);
    font-size: 0.92rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.15rem 0;
}

.lvr-summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    color: #64748b;
}

.lvr-summary-row strong {
    color: #0f172a;
    font-weight: 700;
    max-width: 175px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: right;
}

.lvr-summary-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 600;
}

.lvr-summary-pill.tentative {
    background: #fef3c7;
    color: #92400e;
    margin-top: 0.25rem;
}
.lvr-summary-pill.tentative strong {
    color: #0f172a;
    font-family: var(--lvr-font-display);
    font-size: 0.88rem;
}

.lvr-summary-pill.definitive {
    background: #e0f2fe;
    color: #0369a1;
}
.lvr-summary-pill.definitive strong {
    color: #0f172a;
    font-family: var(--lvr-font-display);
    font-size: 1.15rem;
}

.lvr-btn-save-note {
    width: 100%;
    height: 46px;
    border-radius: 9999px;
    background: #0f172a;
    color: #ffffff;
    border: none;
    font-family: var(--lvr-font-body);
    font-size: 0.88rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    box-shadow: var(--lvr-shadow-lift);
    transition: background 0.2s, transform 0.1s;
    margin-top: 0.25rem;
}
.lvr-btn-save-note:hover { background: #1e293b; }

.lvr-btn-cancel-note {
    display: block;
    text-align: center;
    color: #64748b;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    padding: 4px 0;
}
.lvr-btn-cancel-note:hover { color: #0f172a; }

/* Fix para que intl-tel-input respete el espacio de la bandera en Teléfono WhatsApp */
.lvr-receipt-page .iti {
    width: 100% !important;
    display: block !important;
}

.lvr-receipt-page .iti input[type="tel"].lvr-input,
.lvr-receipt-page input#phone_input.lvr-input {
    padding-left: 52px !important;
    padding-right: 14px !important;
}

.lvr-receipt-page .iti--separate-dial-code input[type="tel"].lvr-input,
.lvr-receipt-page .iti--separate-dial-code input#phone_input.lvr-input {
    padding-left: 88px !important;
}

/* Responsive de Create/Edit Receipt (Img 2 y 3) */
@media (max-width: 1080px) {
    .lvr-form-layout {
        grid-template-columns: minmax(0, 1fr);
    }
    .lvr-form-sidebar {
        position: static;
        width: 100%;
    }
}

@media (max-width: 640px) {
    .lvr-page-title {
        font-size: 1.35rem;
    }
    .lvr-step-card,
    .lvr-private-card,
    .lvr-summary-card {
        padding: 1.1rem;
        border-radius: 16px;
    }
    .lvr-fields-grid-2 {
        grid-template-columns: minmax(0, 1fr);
        gap: 0.85rem;
    }
    .lvr-item-grid-top {
        grid-template-columns: 70px minmax(0, 1fr) minmax(0, 1fr);
        gap: 0.55rem;
    }
    .lvr-item-grid-bottom {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.55rem;
    }
    .lvr-ask-pill-btn {
        max-width: calc(100% - 42px);
    }
}

/* =========================================================
   COMPLEMENTO: TEXTAREAS DE 2 LÍNEAS Y BOTONES INFERIORES
   ========================================================= */

.lvr-item-stack-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
}

.lvr-textarea-2lines {
    width: 100% !important;
    min-height: 62px !important;
    height: auto !important;
