}

.lvr-login-logo {
    height: 50px;
    width: auto;
    object-fit: contain;
    margin-bottom: 1rem;
}

.lvr-login-badge {
    background-color: #f3f4f6;
    color: #4b5563;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid #e5e7eb;
